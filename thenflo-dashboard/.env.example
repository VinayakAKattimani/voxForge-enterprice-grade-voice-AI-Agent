# Base URL of the ThenFLo API Gateway. All service calls in src/services/api
# are routed through this single origin -- never point the frontend at
# individual backend services (STT, TTS, automation, etc) directly.
VITE_API_BASE_URL=https://api.thenflo.ai/v1

# When true, every service in src/services/api serves realistic mock data
# instead of calling the network. Flip to false once the API Gateway above
# is reachable -- no page or component code needs to change.
VITE_USE_MOCK=true
