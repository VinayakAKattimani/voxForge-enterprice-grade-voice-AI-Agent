APP_NAME=STT Service
APP_VERSION=1.0.0
API_V1_STR=/api/v1

POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root123
POSTGRES_DB=voxforge_stt_db

UPLOAD_DIR=storage/uploads
TRANSCRIPT_DIR=storage/transcripts

MAX_AUDIO_SIZE_MB=100

ALLOWED_AUDIO_TYPES=audio/webm,audio/ogg,audio/wav,audio/mpeg,audio/mp4,audio/x-m4a

STT_PROVIDER=faster-whisper

WHISPER_MODEL=small.en
DEVICE=cpu
COMPUTE_TYPE=int8

MAX_FILE_SIZE_MB=100

ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a,flac,ogg,webm

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092